// Closure capturing loop variable (shared state)
fun makeAccumulator() {
  var sum = 0;
  var i = 0;
  while (i < 5) {
    sum = sum + i;
    i++;
  }
  fun get() { print sum; }
  return get;
}
makeAccumulator()();  // 0+1+2+3+4 = 10

// Closure + for loop with break
fun firstEven(arr) {
  var result = -1;
  for (var i = 0; i < len(arr); i++) {
    if (mod(arr[i], 2) == 0) {
      result = arr[i];
      break;
    }
  }
  fun get() { print result; }
  return get;
}
firstEven([1, 3, 7, 4, 9])();  // 4

// Closure capturing variable modified across continue
fun sumOdds(n) {
  var sum = 0;
  var i = 0;
  while (i < n) {
    i++;
    if (mod(i, 2) == 0) continue;
    sum = sum + i;
  }
  fun get() { print sum; }
  return get;
}
sumOdds(10)();  // 1+3+5+7+9 = 25

// Nested loops, closure captures outer loop var
fun outerSum() {
  var total = 0;
  var i = 1;
  while (i <= 3) {
    var j = 1;
    while (j <= 3) {
      if (j == 2) {
        j++;
        continue;
      }
      total = total + i * j;
      j++;
    }
    i++;
  }
  fun get() { print total; }
  return get;
}
outerSum()();  // i*j for j in {1,3}, i in {1,2,3} = (1+3)+(2+6)+(3+9) = 24

// Closure returned from loop body captures closed-over counter
fun makeMultipliers() {
  var results = [0, 0, 0];
  var i = 0;
  while (i < 3) {
    var factor = i + 1;
    results[i] = factor * 10;
    i++;
  }
  fun get() {
    print results[0];
    print results[1];
    print results[2];
  }
  return get;
}
makeMultipliers()();  // 10 20 30
